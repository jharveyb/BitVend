# Copy to /etc/bitvend.env on the Pi, then: sudo chmod 600 /etc/bitvend.env

# From `lexe create-client ...` (see SETUP.md). Receive-only: can't spend.
LEXE_CLIENT_CREDENTIALS=

# `mainnet` for real money, `testnet3` for testing.
BITVEND_NETWORK=mainnet

# Where the payment history cache lives (default ~/.lexe).
#LEXE_DATA_DIR=/home/dci/.lexe

# Set to `fake` to log pulses instead of driving the GPIO pin.
#BITVEND_GPIO=fake

# GPIO wired to Arduino pin 10, as a BCM number (not the physical pin number).
# Default 18, which is physical pin 12.
#BITVEND_GPIO_PIN=18

# Optional heartbeat URL for monitoring, e.g. a free check from https://healthchecks.io.
# Pinged about once a minute while healthy; `<url>/fail` (with the error) when not.
#BITVEND_HEALTHCHECK_URL=https://hc-ping.com/your-uuid

# Milliseconds per quarter pulse (default 200, minimum 100). Lower is faster;
# tune it on the machine and keep the lowest value that never drops a quarter.
BITVEND_QUARTER_PERIOD_MS=125
